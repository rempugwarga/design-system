{
  "name": "@rempugwarga/design-system",
  "version": "0.1.5",
  "description": "Design system rempugwarga: komponen React yang dikonsumsi melalui npm (semver) atau Module Federation remote",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rempugwarga/design-system.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "prepublishOnly": "rslib build",
    "build:storybook": "SKIP_PUBLINT=1 storybook build",
    "dev": "rslib build --watch",
    "storybook": "SKIP_PUBLINT=1 storybook dev -p 6006",
    "mf-dev": "rslib mf-dev",
    "typecheck": "tsc --noEmit",
    "test": "rstest run",
    "test:watch": "rstest --watch",
    "changeset": "changeset",
    "check:changeset": "bash scripts/require-changeset.sh",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@module-federation/rsbuild-plugin": "^2.9.2",
    "@module-federation/storybook-addon": "^6.0.21",
    "@rsbuild/core": "2.2.13",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rslib/core": ">=0.23.2",
    "@rstest/core": "^0.12.3",
    "@storybook/addon-links": "^10.6.2",
    "@storybook/addon-onboarding": "^10.6.2",
    "@storybook/react": "^10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "~19.3.0",
    "happy-dom": "^21.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rsbuild-plugin-publint": "^0.2.1",
    "storybook": "^10.6.2",
    "storybook-addon-rslib": "^3.6.1",
    "storybook-react-rsbuild": "^3.6.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=16.9.0",
    "react-dom": ">=16.9.0"
  }
}
